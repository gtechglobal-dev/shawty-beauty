# ------------------------------------------------------------------
# Shawty Beauty Studio - environment variables
# Copy this file to .env (or set the same keys in your Render.com
# service under Environment) and fill in real values. NEVER commit
# .env — it is already gitignored.
# ------------------------------------------------------------------

# MongoDB connection string
MONGO_URI=mongodb://user:password@cluster...

# Allowed CORS origin (the deployed app URL)
CORS_ORIGIN=http://localhost:5173

# Public base URL - used to build Paystack payment callback links
# and the QR check-in + ticket download URLs.
# e.g. https://shawty-beauty-studio.onrender.com
BASE_URL=https://shawty-beauty-studio.onrender.com

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign admin JWT tokens
JWT_SECRET=change-me

# Paystack (ticket payments)
# Public key can be shown to clients; secret key must stay private
PAYSTACK_PUBLIC_KEY=pk_...
PAYSTACK_SECRET_KEY=sk_...

# Telegram notifications (send form submissions to your Telegram)
# 1. Message @BotFather on Telegram -> /newbot -> get the bot token
# 2. Get your chat id: message @userinfobot or add your bot to your group/channel
#    and use the chat/channel id (group ids start with a minus sign)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email delivery (pick ONE of the two modes) ---

# MODE 1 (recommended for Render/cloud hosts): Brevo REST API over HTTPS (port 443).
# Create a key in Brevo -> Settings -> SMTP & API -> API Keys, then set:
BREVO_API_KEY=

# MODE 2 (classic SMTP relay via nodemailer; often blocked from datacenter IPs):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Sender used on outbound mail. MUST be a sender verified in Brevo.
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Shawty Beauty Studio

# Telegram ADMIN bot (optional) — lets you query site data via slash commands
# in Telegram. TELEGRAM_ADMIN_IDS is a comma-separated list of your Telegram
# user ids that are allowed to use the bot (find yours via @userinfobot).
# TELEGRAM_ADMIN_IDS=123456789,987654321

# Cloudinary (image storage) — profile photos, sponsor logos and event banners
# are uploaded here and auto stepped down to ~100 KB. When these are unset the
# app falls back to storing base64 in the database.
# Credentials: Cloudinary Dashboard -> Account Details, or under "API Keys".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=