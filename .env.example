# ------------------------------------------------------------------
# Shawty Beauty Studio - environment variables
# Copy this file to .env (or set the same keys in your Render.com
# service under Environment) and fill in real values. NEVER commit
# .env — it is already gitignored.
# ------------------------------------------------------------------

# MongoDB connection string
MONGO_URI=mongodb://user:password@cluster...

# Allowed CORS origin (the deployed app URL)
CORS_ORIGIN=http://localhost:5173

# Public base URL - used to build Paystack payment callback links
# e.g. https://shawty-beauty.onrender.com
BASE_URL=http://localhost:5173

# Admin dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign admin JWT tokens
JWT_SECRET=change-me

# Paystack (ticket payments)
# Public key can be shown to clients; secret key must stay private
PAYSTACK_PUBLIC_KEY=pk_...
PAYSTACK_SECRET_KEY=sk_...

# Telegram notifications (send form submissions to your Telegram)
# 1. Message @BotFather on Telegram -> /newbot -> get the bot token
# 2. Get your chat id: message @userinfobot or add your bot to your group/channel
#    and use the chat/channel id (group ids start with a minus sign)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram ADMIN bot (optional) — lets you query site data via slash commands
# in Telegram. TELEGRAM_ADMIN_IDS is a comma-separated list of your Telegram
# user ids that are allowed to use the bot (find yours via @userinfobot).
# TELEGRAM_ADMIN_IDS=123456789,987654321